C4Context
    title Core/Port/Board-Aufteilung

    System(beaglebone_black, "BeagleBone Black (AM335x)", "Cortex-A8 @ 1 GHz, Single-Core, VFPv3-D16 ohne NEON, UART0, GPIO1, DMTimer, Boot über bestehendes u-boot.")
    System(rosek_board_bbb, "rosek-board-beaglebone-black", "Rust", "Nur das Board-Spezifische: Pin-Muxing, Taktkonfiguration, Speicherkarte, welche UART/GPIO-Pins tatsächlich herausgeführt sind.")
    System(rosek_core, "rosek-core", "Rust", "Komplett architektur- und boardneutral: Scheduler, OS-Application-Modell, Memory-Protection-Logik, Static-Config-Verarbeitung. Kennt nur Rust-Traits (HAL), keine Register.")
    System(rosek_hal, "rosek-hal", "Rust (Trait-Definitionen)", "Definiert die Trait-Schnittstellen, die rosek-core braucht: Timer, InterruptController, Mmu, Uart, Gpio.")
    System(rosek_port_am335x, "rosek-port-am335x", "Rust", "Implementierung der HAL-Traits für die AM335x-SoC-Familie: Register-Layout, Interrupt-Controller-Typ, MMU-Aufbau. Gilt für alle Boards mit diesem SoC.")

    Rel(rosek_core, rosek_hal, "Timer, InterruptController, Mmu, Uart, Gpio")
    Rel(rosek_port_am335x, rosek_hal, "AM335x-Register")
    Rel(rosek_board_bbb, rosek_port_am335x, "SoC-Familie AM335x")
    Rel(rosek_board_bbb, rosek_core, "bindet Kernel Core ein")
    Rel(rosek_board_bbb, beaglebone_black, "Raw-Binary via u-boot")
