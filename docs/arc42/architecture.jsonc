{
  "$schema": "https://raw.githubusercontent.com/docToolchain/Bausteinsicht/main/schemas/bausteinsicht.schema.json",

  // Architekturmodell für rOSEK. Bildet zwei Sichten aus PLAN.md ab:
  //  - "layers": das Schichtenmodell (API/Core/HAL/Static-Config), PLAN.md Abschnitt "Architektur"
  //  - "crates": die Core/Port/Board-Aufteilung, PLAN.md Abschnitt "Portierbarkeit: Core / Port / Derivat"
  // Wird über `bausteinsicht sync` / `export-diagram` / `export-table` / `lint` ausgewertet;
  // siehe docs/arc42/05-bausteinsicht.adoc für die daraus generierten Inhalte.

  "specification": {
    "elements": {
      "layer": {
        "notation": "Schicht",
        "description": "Eine der vier logischen Schichten aus PLAN.md \"Architektur\"",
        "container": true
      },
      "crate": {
        "notation": "Rust Crate",
        "description": "Ein Cargo-Workspace-Member"
      },
      "hardware": {
        "notation": "Zielhardware",
        "description": "Physisches Zielsystem, auf dem ein Board-Crate läuft"
      }
    },
    "relationships": {
      "calls": {
        "notation": "ruft auf"
      },
      "usesTraits": {
        "notation": "kennt nur Traits von"
      },
      "implements": {
        "notation": "implementiert"
      },
      "dependsOn": {
        "notation": "hängt ab von"
      },
      "generates": {
        "notation": "generiert Konstanten für"
      },
      "runsOn": {
        "notation": "läuft auf",
        "dashed": true
      },
      "buildDependsOn": {
        "notation": "nutzt zur Build-Zeit",
        "dashed": true
      }
    }
  },

  "model": {
    // --- Schichtenmodell (Sicht "layers") ---
    "api_layer": {
      "kind": "layer",
      "title": "API-Layer",
      "description": "ActivateTask, Schedule, GetTaskID, ... — die AUTOSAR-OS-Services (Teilmenge, wachsend mit den Phasen)"
    },
    "kernel_core": {
      "kind": "layer",
      "title": "Kernel Core",
      "description": "Scheduler, OS-Applications, Memory-Protection-Logik — architekturneutral gehalten, wo möglich"
    },
    "hal_port_layer": {
      "kind": "layer",
      "title": "HAL/Port-Layer (AM335x)",
      "description": "MMU, INTC, DMTimer, UART0, GPIO1 — alles AM335x-Spezifische"
    },
    "static_config_layer": {
      "kind": "layer",
      "title": "Static-Config-Layer",
      "description": "OIL-ähnliche .cfg-Datei -> build.rs -> generierte Rust-Konstanten, keine dynamische Allokation zur Laufzeit"
    },

    // --- Core/Port/Board-Aufteilung (Sicht "crates") ---
    "rosek_core": {
      "kind": "crate",
      "title": "rosek-core",
      "technology": "Rust",
      "tags": ["portable"],
      "description": "Komplett architektur- und boardneutral: Scheduler, OS-Application-Modell, Memory-Protection-Logik, Static-Config-Verarbeitung. Kennt nur Rust-Traits (HAL), keine Register.",
      "link": "../../PLAN.md#portierbarkeit-core--port--derivat"
    },
    "rosek_hal": {
      "kind": "crate",
      "title": "rosek-hal",
      "technology": "Rust (Trait-Definitionen)",
      "tags": ["portable"],
      "description": "Definiert die Trait-Schnittstellen, die rosek-core braucht: Timer, InterruptController, Mmu, Uart, Gpio.",
      "link": "../../PLAN.md#portierbarkeit-core--port--derivat"
    },
    "rosek_port_am335x": {
      "kind": "crate",
      "title": "rosek-port-am335x",
      "technology": "Rust",
      "tags": ["concrete", "soc-specific"],
      "description": "Implementierung der HAL-Traits für die AM335x-SoC-Familie: Register-Layout, Interrupt-Controller-Typ, MMU-Aufbau. Gilt für alle Boards mit diesem SoC.",
      "link": "../../PLAN.md#portierbarkeit-core--port--derivat"
    },
    "rosek_board_bbb": {
      "kind": "crate",
      "title": "rosek-board-beaglebone-black",
      "technology": "Rust",
      "tags": ["concrete", "board-specific"],
      "description": "Nur das Board-Spezifische: Pin-Muxing, Taktkonfiguration, Speicherkarte, welche UART/GPIO-Pins tatsächlich herausgeführt sind.",
      "link": "../../PLAN.md#portierbarkeit-core--port--derivat"
    },
    "beaglebone_black": {
      "kind": "hardware",
      "title": "BeagleBone Black (AM335x)",
      "description": "Cortex-A8 @ 1 GHz, Single-Core, VFPv3-D16 ohne NEON, UART0, GPIO1, DMTimer, Boot über bestehendes u-boot.",
      "link": "../../PLAN.md#zielhardware"
    },
    "rosek_config": {
      "kind": "crate",
      "title": "rosek-config",
      "technology": "Rust (std, Host)",
      "tags": ["build-tooling"],
      "description": "Reine Host/std-Crate: parst die OIL-inspirierte .cfg-Datei und generiert daraus Rust-Konstanten. Läuft nur zur Build-Zeit (aus rosek-board-beaglebone-black/build.rs heraus), nie auf dem Ziel-Target — daher weder \"portable\" noch \"concrete\" im Sinne von C01, sondern eine eigene, orthogonale Kategorie.",
      "link": "../../PLAN.md#architektur"
    }
  },

  "relationships": [
    { "from": "api_layer",            "to": "kernel_core",         "kind": "calls",    "label": "API-Aufrufe" },
    { "from": "kernel_core",          "to": "hal_port_layer",      "kind": "calls",    "label": "HAL-Traits" },
    { "from": "static_config_layer",  "to": "kernel_core",         "kind": "generates","label": "Tasks/OS-Apps/Resources" },
    { "from": "static_config_layer",  "to": "hal_port_layer",      "kind": "generates","label": "Register-/Pin-Konstanten" },

    { "from": "rosek_core",           "to": "rosek_hal",           "kind": "usesTraits", "label": "Timer, InterruptController, Mmu, Uart, Gpio" },
    { "from": "rosek_port_am335x",    "to": "rosek_hal",           "kind": "implements", "label": "AM335x-Register" },
    { "from": "rosek_board_bbb",      "to": "rosek_port_am335x",   "kind": "dependsOn",  "label": "SoC-Familie AM335x" },
    { "from": "rosek_board_bbb",      "to": "rosek_core",          "kind": "dependsOn",  "label": "bindet Kernel Core ein" },
    { "from": "rosek_board_bbb",      "to": "beaglebone_black",    "kind": "runsOn",     "label": "Raw-Binary via u-boot" },
    { "from": "rosek_board_bbb",      "to": "rosek_config",        "kind": "buildDependsOn", "label": "build.rs: .cfg -> Rust-Konstanten" }
  ],

  "constraints": [
    {
      "id": "C01",
      "description": "rosek-core und rosek-hal (Tag \"portable\") dürfen nicht von SoC-/Board-spezifischen Crates (Tag \"concrete\") abhängen — Portierbarkeitsprinzip aus PLAN.md: ein neues Target bedeutet einen neuen rosek-port-*/rosek-board-*, nie eine Änderung an rosek-core.",
      "rule": "no-relationship",
      "from-tag": "portable",
      "to-tag": "concrete"
    },
    {
      "id": "C02",
      "description": "Jedes Crate muss seine Technologie deklarieren.",
      "rule": "required-field",
      "element-kind": "crate",
      "field": "technology"
    },
    {
      "id": "C03",
      "description": "Keine zirkulären Abhängigkeiten zwischen Schichten oder Crates.",
      "rule": "no-circular-dependency"
    }
  ],

  "views": {
    "layers": {
      "title": "Schichtenarchitektur",
      "description": "Die vier logischen Schichten aus PLAN.md \"Architektur\": API-Layer, Kernel Core, HAL/Port-Layer, Static-Config-Layer.",
      "include": ["api_layer", "kernel_core", "hal_port_layer", "static_config_layer"],
      "layout": "layered"
    },
    "crates": {
      "title": "Core/Port/Board-Aufteilung",
      "description": "Die Cargo-Workspace-Aufteilung aus PLAN.md \"Portierbarkeit: Core / Port / Derivat\": rosek-core und rosek-hal sind board-/architekturneutral, rosek-port-am335x und rosek-board-beaglebone-black sind konkret.",
      "include": ["rosek_core", "rosek_hal", "rosek_port_am335x", "rosek_board_bbb", "beaglebone_black", "rosek_config"],
      "layout": "layered"
    }
  }
}
